		{
			"name": "Wallester Direct",
			"description": "API Wallester directa. Antes: php postman/scripts/sync-postman-env.php e importar wallester-sandbox.local.postman_environment.json",
			"auth": {
				"type": "bearer",
				"bearer": [
					{
						"key": "token",
						"value": "{{wallester_jwt}}",
						"type": "string"
					}
				]
			},
			"item": [
				{
					"name": "Create Account",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"var json = pm.response.json();",
									"var account = json.account || json;",
									"if (account.id) { pm.environment.set('wallester_account_id', account.id); }"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json", "type": "text" },
							{ "key": "Content-Type", "value": "application/json", "type": "text" },
							{ "key": "X-Product-Code", "value": "{{wallester_product_code}}", "type": "text" },
							{ "key": "X-Audit-Source-Type", "value": "{{wallester_audit_source_type}}", "type": "text" },
							{ "key": "X-Audit-User-Id", "value": "{{wallester_audit_user_id}}", "type": "text" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n\t\"name\": \"Postman Test Account\"\n}"
						},
						"url": {
							"raw": "{{wallester_base_url}}/accounts",
							"host": ["{{wallester_base_url}}"],
							"path": ["accounts"]
						}
					}
				},
				{
					"name": "Create Card Virtual",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"var json = pm.response.json();",
									"var card = json.card || json;",
									"if (card.id) { pm.environment.set('wallester_card_id', card.id); }"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json", "type": "text" },
							{ "key": "Content-Type", "value": "application/json", "type": "text" },
							{ "key": "X-Product-Code", "value": "{{wallester_product_code}}", "type": "text" },
							{ "key": "X-Audit-Source-Type", "value": "{{wallester_audit_source_type}}", "type": "text" },
							{ "key": "X-Audit-User-Id", "value": "{{wallester_audit_user_id}}", "type": "text" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n\t\"account_id\": \"{{wallester_account_id}}\",\n\t\"type\": \"Virtual\",\n\t\"name\": \"Postman Virtual Card\",\n\t\"3d_secure_settings\": {\n\t\t\"out_of_band_enabled\": true,\n\t\t\"out_of_band_id\": \"{{wallester_oob_id}}\"\n\t},\n\t\"security\": {\n\t\t\"contactless_enabled\": true,\n\t\t\"withdrawal_enabled\": false,\n\t\t\"internet_purchase_enabled\": true\n\t}\n}"
						},
						"url": {
							"raw": "{{wallester_base_url}}/cards",
							"host": ["{{wallester_base_url}}"],
							"path": ["cards"]
						}
					}
				},
				{
					"name": "Activate Card",
					"request": {
						"method": "PATCH",
						"header": [
							{ "key": "Accept", "value": "application/json", "type": "text" },
							{ "key": "X-Product-Code", "value": "{{wallester_product_code}}", "type": "text" },
							{ "key": "X-Audit-Source-Type", "value": "{{wallester_audit_source_type}}", "type": "text" },
							{ "key": "X-Audit-User-Id", "value": "{{wallester_audit_user_id}}", "type": "text" }
						],
						"url": {
							"raw": "{{wallester_base_url}}/cards/{{wallester_card_id}}/activate",
							"host": ["{{wallester_base_url}}"],
							"path": ["cards", "{{wallester_card_id}}", "activate"]
						}
					}
				},
				{
					"name": "List Account Transactions",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json", "type": "text" },
							{ "key": "X-Product-Code", "value": "{{wallester_product_code}}", "type": "text" },
							{ "key": "X-Audit-Source-Type", "value": "{{wallester_audit_source_type}}", "type": "text" },
							{ "key": "X-Audit-User-Id", "value": "{{wallester_audit_user_id}}", "type": "text" }
						],
						"url": {
							"raw": "{{wallester_base_url}}/accounts/{{wallester_account_id}}/transactions?from_record=0&records_count=15",
							"host": ["{{wallester_base_url}}"],
							"path": ["accounts", "{{wallester_account_id}}", "transactions"],
							"query": [
								{ "key": "from_record", "value": "0" },
								{ "key": "records_count", "value": "15" }
							]
						}
					}
				}
			]
		}
	]
